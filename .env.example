# Parliament Django Environment Variables — matches Parliament/settings.py (unified, v3.12.0)
# Copy this file to .env and update with your actual values.
# Every name below is read by settings.py; names not listed here are not used.

# --- Core Django ---
# Secret key: DJANGO_SECRET_KEY preferred; legacy SECRET_KEY also accepted.
# Required in production (DEBUG=False) — startup fails without it.
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-get-secret-key
# Debug: DJANGO_DEBUG preferred; legacy DEBUG also accepted.
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
SITE_URL=https://am-parliament.org
# Extra CSRF origins (comma-separated). SITE_URL is always trusted automatically.
#CSRF_TRUSTED_ORIGINS=https://www.your-domain.com

# --- Database ---
# DB_BACKEND=sqlite -> zero-config local SQLite (db.sqlite3 in repo root); ignores DB_* below.
# Leave unset (or anything else) for PostgreSQL.
#DB_BACKEND=sqlite
DB_ENGINE=django.db.backends.postgresql
DB_NAME=parliament_db
DB_USER=parliament_user
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=300

# --- Field-level encryption (REQUIRED in production) ---
# Generate with: python3 generate_encryption_key.py
ENCRYPTION_KEY=your-fernet-key-here

# --- Redis (cache, sessions, channels, celery broker; falls back to local memory/db if unset) ---
#REDIS_URL=redis://127.0.0.1:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@am-parliament.org
#SECURITY_ALERT_EMAIL=security@your-domain.com
# Brevo API (used when EMAIL_BACKEND=anymail.backends.brevo.EmailBackend)
#BREVO_API_KEY=

# --- Static & media ---
# DJANGO_-prefixed preferred; unprefixed also accepted.
DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_URL=/media/
MEDIA_ROOT=media

# --- Security / proxy ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Set True when behind Cloudflare (enables CF-Connecting-IP for real client IPs)
BEHIND_CLOUDFLARE=False

# --- IP geolocation (login anomaly / foreign-login detection) ---
# ip-api.com free tier is HTTP-only; set an HTTPS endpoint to avoid cleartext lookups.
GEO_API_BASE_URL=http://ip-api.com/json/

# --- Two-factor auth ---
REQUIRE_2FA_FOR_ADMINS=True
REQUIRE_2FA_FOR_OFFICERS=True
OTP_TOTP_ISSUER=Parliament

# --- Web push (VAPID) — see generation instructions in settings.py ---
#VAPID_PRIVATE_KEY=
#VAPID_PUBLIC_KEY=

# --- Logging ---
# Echo logs to stdout as well as file (useful for containers/journald)
LOG_TO_CONSOLE=False
#LOG_DIR=logs
#LOG_FILE_NAME=django_actions.log

# --- Misc ---
TIME_ZONE=America/Chicago
USE_TZ=True
