# Parliament — local Docker development environment
# Copy to .env.dev (already gitignored) and leave as-is for local use.
#
# DO NOT use these values in production.

# Django
SECRET_KEY=dev-secret-key-not-for-production-use-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=Parliament.settings_postgres

# Database — matches docker-compose.dev.yml db service
DB_ENGINE=django.db.backends.postgresql
DB_NAME=parliament_dev
DB_USER=parliament_user
DB_PASSWORD=devpassword
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=0

# Redis
REDIS_URL=redis://redis:6379/0

# Email — print to console instead of sending
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security — all off for local dev
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Static / media
STATIC_URL=/static/
MEDIA_URL=/media/

# Logging
LOG_LEVEL=DEBUG

# Timezone
TIME_ZONE=America/Chicago

# Chapter info
PARLIAMENT_CHAPTER_NAME=Alpha Mu
PARLIAMENT_ORGANIZATION=Beta Theta Pi
