[Unit]
# NOTE (07-05-26): Despite the filename, this unit runs DAPHNE (ASGI), not
# gunicorn — Daphne is required for WebSockets (chat). The filename matches
# the unit actually installed on prod (/etc/systemd/system/). If you ever
# rename it to parliament-daphne.service (recommended for clarity):
#   systemctl disable --now parliament-gunicorn
#   mv /etc/systemd/system/parliament-{gunicorn,daphne}.service
#   systemctl daemon-reload && systemctl enable --now parliament-daphne
Description=Parliament Daphne Application Server (ASGI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
# SECURITY (07-06-26): run as a dedicated unprivileged user, NOT root.
# Root would turn any app-level RCE into full-system compromise and undermines
# NoNewPrivileges/PrivateTmp below.
# One-time setup on prod BEFORE deploying this file:
#   useradd --system --home /var/www/Parliament-New --shell /usr/sbin/nologin parliament
#   usermod -aG parliament www-data        # nginx needs rw on the unix socket
#   chown -R parliament:parliament /var/www/Parliament-New
#   cp parliament-gunicorn.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl restart parliament-gunicorn
# Then verify: ps -o user= -C daphne  → parliament ; site + chat (WebSocket) work.
User=parliament
Group=parliament
# Socket is created by daphne as parliament:parliament; UMask 0007 + www-data
# in the parliament group gives nginx rw without exposing it world-wide.
UMask=0007
WorkingDirectory=/var/www/Parliament-New

# Environment variables
Environment="PATH=/var/www/Parliament-New/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=Parliament.settings"
EnvironmentFile=/var/www/Parliament-New/.env

# Daphne serves both HTTP and WebSockets over the unix socket nginx proxies to.
ExecStart=/var/www/Parliament-New/venv/bin/daphne \
    -u /var/www/Parliament-New/parliament.sock \
    Parliament.asgi:application

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (optional but recommended)
LimitAS=268435456
# 256MB in bytes
MemoryLimit=256M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parliament-daphne

[Install]
WantedBy=multi-user.target
