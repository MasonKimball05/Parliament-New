[Unit]
# NOTE (07-05-26): Despite the filename, this unit runs DAPHNE (ASGI), not
# gunicorn — Daphne is required for WebSockets (chat). The filename matches
# the unit actually installed on prod (/etc/systemd/system/). If you ever
# rename it to parliament-daphne.service (recommended for clarity):
#   systemctl disable --now parliament-gunicorn
#   mv /etc/systemd/system/parliament-{gunicorn,daphne}.service
#   systemctl daemon-reload && systemctl enable --now parliament-daphne
Description=Parliament Daphne Application Server (ASGI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
# User and group to run as (adjust as needed)
User=root
Group=root
WorkingDirectory=/var/www/Parliament-New

# Environment variables
Environment="PATH=/var/www/Parliament-New/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=Parliament.settings"
EnvironmentFile=/var/www/Parliament-New/.env

# Daphne serves both HTTP and WebSockets over the unix socket nginx proxies to.
ExecStart=/var/www/Parliament-New/venv/bin/daphne \
    -u /var/www/Parliament-New/parliament.sock \
    Parliament.asgi:application

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (optional but recommended)
LimitAS=268435456
# 256MB in bytes
MemoryLimit=256M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parliament-daphne

[Install]
WantedBy=multi-user.target
